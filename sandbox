#!/usr/bin/env bash
set -e

IMG=${SANDBOX_IMAGE:-sandbox:alma9}
REPOS=${SANDBOX_CVMFS_REPOS:-"cvmfs-config.cern.ch sft.cern.ch sft-nightlies.cern.ch atlas.cern.ch atlas-condb.cern.ch atlas-nightlies.cern.ch unpacked.cern.ch"}
DIR=$(dirname "$(readlink -f "$0")")
CTX=$DIR/image
RC=$DIR/bashrc.sh
CLAUDE_MD=$DIR/CLAUDE.md

HASH=$(find "$CTX" -type f -exec sha256sum {} + | sort | sha256sum | cut -d' ' -f1)

[ "$1" = "--rebuild" ] && { shift; docker build --pull --label sandbox.contenthash="$HASH" -t "$IMG" "$CTX"; [ $# -eq 0 ] && exit 0; }

CUR_HASH=$(docker image inspect -f '{{ index .Config.Labels "sandbox.contenthash" }}' "$IMG" 2>/dev/null || true)
[ "$CUR_HASH" = "$HASH" ] || docker build --label sandbox.contenthash="$HASH" -t "$IMG" "$CTX"

[ "$PWD" = "$HOME" ] && { echo "sandbox: refusing to mount \$HOME as workdir"; exit 1; }
[ -f "$RC" ] || { echo "sandbox: missing $RC"; exit 1; }
[ -f "$CLAUDE_MD" ] || { echo "sandbox: missing $CLAUDE_MD"; exit 1; }
[ -t 0 ] && TTY=-it

ROOTRC_MOUNT=(); [ -f "$HOME/.rootrc" ] && ROOTRC_MOUNT=(-v "$HOME/.rootrc":/home/"$USER"/.rootrc:ro)
NVIM_MOUNT=(); [ -d "$HOME/.config/nvim" ] && NVIM_MOUNT=(-v "$HOME/.config/nvim":/home/"$USER"/.config/nvim:ro)
GITCONFIG_MOUNT=(); [ -f "$HOME/.gitconfig" ] && GITCONFIG_MOUNT=(-v "$HOME/.gitconfig":/home/"$USER"/.gitconfig:ro)

exec docker run --rm $TTY --hostname sandbox \
  --cap-add SYS_ADMIN --device /dev/fuse --security-opt apparmor=unconfined \
  -v "$PWD":/work \
  -v sandbox-home:/home/"$USER" \
  -v sandbox-cvmfs:/var/lib/cvmfs \
  -v "$RC":/etc/bashrc_sandbox:ro \
  -v "$CLAUDE_MD":/home/"$USER"/.claude/CLAUDE.md:ro \
  "${ROOTRC_MOUNT[@]}" "${NVIM_MOUNT[@]}" "${GITCONFIG_MOUNT[@]}" \
  -e HOST_USER="$USER" -e HOST_UID="$(id -u)" -e HOST_GID="$(id -g)" \
  -e CVMFS_REPOS="$REPOS" \
  -e TERM="${TERM:-xterm-256color}" \
  "$IMG" "$@"
